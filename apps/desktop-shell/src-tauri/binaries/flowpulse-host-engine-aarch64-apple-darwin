#!/usr/bin/env bash
# Dev-mode sidecar launcher for `tauri dev` on macOS Apple Silicon (`aarch64-apple-darwin`).
# Overwritten with a standalone PyInstaller binary when running `python3 scripts/build_sidecar.py`.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "${ROOT_DIR}/services/host-engine"
export OLLAMA_FLASH_ATTENTION=1
export OLLAMA_KEEP_ALIVE=-1
export FLOWPULSE_OLLAMA_MODEL="${FLOWPULSE_OLLAMA_MODEL:-qwen3.5:35b-a3b}"
exec ./.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8420
