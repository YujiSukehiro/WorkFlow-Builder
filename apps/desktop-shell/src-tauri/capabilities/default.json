{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for FlowPulse macOS window and host-engine sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/flowpulse-host-engine",
          "sidecar": true
        }
      ]
    }
  ]
}
